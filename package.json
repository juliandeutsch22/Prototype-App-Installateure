{
  "name": "installateur-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Mandantenfähige Installateur-Betriebssoftware mit KI-Magic-Moment (Sprache zu Struktur)",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run gemeinsames",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "gemeinsames": "node functions/scripts/shared-uebernehmen.mjs && node scripts/edge-shared-uebernehmen.mjs",
    "pretypecheck": "npm run gemeinsames",
    "typecheck": "tsc --noEmit",
    "emulators": "firebase emulators:start",
    "pretest": "npm run gemeinsames",
    "test": "TZ=Europe/Vienna vitest run",
    "rules:test": "vitest run --config vitest.rules.config.ts",
    "supabase:test": "vitest run --config vitest.supabase.config.ts",
    "stack": "./scripts/stack.sh",
    "presupabase:test": "npm run gemeinsames"
  },
  "dependencies": {
    "@fontsource/poppins": "^5.3.0",
    "@supabase/supabase-js": "^2.116.0",
    "firebase": "^10.12.2",
    "jspdf": "^2.5.1",
    "jspdf-autotable": "^3.8.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.24.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.13.1",
    "@typescript-eslint/parser": "^7.13.1",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.7",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^24.1.3",
    "pg": "^8.23.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.4.5",
    "vite": "^5.3.1",
    "vitest": "^1.6.0"
  }
}
