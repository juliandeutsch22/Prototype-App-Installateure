rules_version = '2';

// Mandantensichere Firestore Security Rules (Spec §7).
//
// Mechanismus: companyId und role stehen als CUSTOM CLAIMS im Auth-Token
// (serverseitig per Cloud Function gesetzt, siehe functions/src/claims.ts).
// Damit kann ein Nutzer ausschließlich Dokumente seiner eigenen companyId
// lesen/schreiben — auch bei direkten Firestore-Anfragen unter Umgehung des UI.
//
// Akzeptanzkriterium (Spec §7): Firma B kann kein einziges Dokument von
// Firma A lesen. Nachgewiesen durch firestore.rules.test.ts.

service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * Angemeldet UND nicht deaktiviert.
     *
     * DIE PRUEFUNG STEHT HIER UND NICHT JE SAMMLUNG. `signedIn()` liegt unter
     * `ownsExisting()`, `ownsIncoming()` und `hasRole()` — also unter jeder
     * Regel dieser Datei. Eine neue Sammlung kann die Sperre damit nicht
     * vergessen.
     *
     * WOGEGEN SIE SCHUETZT. Deaktivieren war vorher eine Anzeigeeinstellung:
     * geprueft wurde nur im Browser (`AuthContext.loadProfile`). Ein
     * ausgeschiedener Mitarbeiter behielt ein gueltiges Konto mit gueltigen
     * Claims und kam mit dem Firestore-SDK unveraendert an Kunden,
     * Baustellen und Scheine. Die Function `syncUserClaims` sperrt zusaetzlich
     * das Auth-Konto und widerruft die Token; dieser Claim ist der dritte
     * Riegel und der einzige, der auch ein noch gueltiges Token stoppt.
     *
     * FEHLT DER CLAIM, GILT AKTIV. Bestehende Token tragen ihn nicht, und ein
     * Deploy darf nicht den ganzen Betrieb aussperren, bis sich jeder neu
     * angemeldet hat. Dieselbe Lesart wie in der App (`active !== false`).
     */
    function signedIn() {
      return request.auth != null
        && (!('active' in request.auth.token) || request.auth.token.active == true);
    }

    function tokenCompany() {
      return request.auth.token.companyId;
    }

    function role() {
      return request.auth.token.role;
    }

    // Daten gehören demselben Mandanten wie der Aufrufer (Lesen/Update/Delete).
    function ownsExisting() {
      return signedIn() && resource.data.companyId == tokenCompany();
    }

    // Neu geschriebene/aktualisierte Daten tragen die companyId des Aufrufers.
    function ownsIncoming() {
      return signedIn() && request.resource.data.companyId == tokenCompany();
    }

    function hasRole(roles) {
      return signedIn() && role() in roles;
    }

    function isAdmin() {
      return hasRole(['Administrator']);
    }

    // Leitung inklusive Projektleitung: plant Baustellen, verteilt Material,
    // rechnet ab. Beim Zeitkonto gilt bewusst topLevel() statt dieser Rolle.
    function isLeadership() {
      return hasRole(['Projektleiter', 'Geschäftsführung', 'Administrator']);
    }

    // Ohne Projektleitung — fuer alles rund um die Zeitkonten der Mitarbeiter.
    // Krankenstaende sind Gesundheitsdaten nach Art. 9 DSGVO; sie bekommt nur,
    // wer sie fuer seine Aufgabe braucht.
    function isTopLevel() {
      return hasRole(['Geschäftsführung', 'Administrator']);
    }

    // Wer fremde Zeitkonten sehen und korrigieren darf.
    function isBuchOrTop() {
      return hasRole(['Buchhaltung', 'Geschäftsführung', 'Administrator']);
    }

    // companyId darf bei Updates nicht verändert werden.
    function companyUnchanged() {
      return request.resource.data.companyId == resource.data.companyId;
    }

    /**
     * Wird am Beleg das VERRECHNET-Kennzeichen angefasst?
     *
     * `isBilled` und `invoiceNumber` entscheiden, ob eine Stunde oder eine
     * Materialposition je auf eine Rechnung kommt: die Rechnungsstellung
     * sammelt nur, was NICHT verrechnet ist. Wer das Kennzeichen selbst
     * setzen kann, nimmt seine eigene Arbeitszeit aus der Verrechnung —
     * still, ohne Fehlermeldung, und niemandem faellt es auf, weil die Zeile
     * im Zeitkonto ganz normal weitersteht.
     *
     * Die Grenze steht hier und nicht in der Oberflaeche: die Formulare
     * schicken diese beiden Felder ueberhaupt nie mit. Genau deshalb kostet
     * dieser Riegel keinen einzigen echten Arbeitsweg — geprueft am Emulator,
     * nicht angenommen.
     */
    function aendertVerrechnung() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['isBilled', 'invoiceNumber']);
    }

    // Beim Anlegen gibt es kein `resource`, also kein diff: hier zaehlt der
    // Wert selbst. Ein Beleg wird nie als bereits verrechnet geboren.
    function legtVerrechnetAn() {
      return request.resource.data.get('isBilled', false) == true
        || request.resource.data.get('invoiceNumber', '') != '';
    }

    // Gültige Rollen. syncUserClaims übernimmt den Wert ungeprüft als Custom
    // Claim — ein Tippfehler ("Geschaeftsfuehrung") würde den Nutzer sonst
    // dauerhaft aussperren, weil keine Regel mehr greift.
    function validRole() {
      return request.resource.data.role in
        ['Mitarbeiter', 'Verwaltung', 'Buchhaltung', 'Projektleiter',
         'Geschäftsführung', 'Administrator'];
    }

    // --- companies: lesen für die eigene Firma; ändern nur Geschäftsführung
    //     und Administrator. Anlegen und Löschen bleiben dem Server
    //     vorbehalten: ein Mandant darf sich nicht selbst entfernen. ---
    //
    // WARUM NICHT DIE PROJEKTLEITUNG. In diesem Dokument steht, was der
    // Betrieb verrechnet (Stundensätze, Zuschläge), wer Urlaub genehmigt und
    // welche Bereiche er überhaupt benutzt. Das sind drei Entscheidungen über
    // den Betrieb, keine über eine Baustelle.
    //
    // Vorher durfte die Projektleitung hier alles ausser zwei ausgenommenen
    // Feldern ändern — also auch den Stundensatz. Die Ausnahmeliste war der
    // Beleg, dass die Grenze eine Stufe zu weit unten lag: sobald man einzelne
    // Felder herausnehmen muss, gehört das ganze Dokument nicht in diese Hand.
    // Der Reiter „Einstellungen" liess sie ohnehin nicht hinein — der Server
    // aber schon, und der zählt.
    match /companies/{companyId} {
      allow read: if signedIn() && companyId == tokenCompany();
      allow update: if isTopLevel() && companyId == tokenCompany();
    }

    /**
     * Wer Urlaubsantraege entscheiden darf.
     *
     * Steht hier und nicht nur in der Oberflaeche: eine Genehmigung schreibt
     * bezahlte Urlaubstage ins Zeitkonto. Wer sie setzen kann, verschafft sich
     * Geld — das muss der Server entscheiden, nicht der Browser.
     *
     * Geschaeftsfuehrung und Administration koennen IMMER. Ohne Festlegung
     * bleibt es beim Ausgangszustand, also zusaetzlich die Buchhaltung; sonst
     * haette das Einfuehren dieser Einstellung bestehenden Betrieben
     * stillschweigend Rechte entzogen.
     */
    function genehmigerListe() {
      return exists(/databases/$(database)/documents/companies/$(tokenCompany()))
        ? get(/databases/$(database)/documents/companies/$(tokenCompany()))
            .data.get('vacationApprovers', [])
        : [];
    }

    function darfUrlaubEntscheiden() {
      return isTopLevel()
        || (genehmigerListe().size() > 0
              ? request.auth.uid in genehmigerListe()
              : hasRole(['Buchhaltung']));
    }

    // --- users: lesen innerhalb der Firma; verwalten nur GF/Admin ---
    //
    // Der Kommentar sagte das schon immer, die Regel tat es nicht: sie liess
    // `isLeadership()` zu, und darin steckt die Projektleitung. Sie haette
    // damit Benutzer anlegen und Rollen vergeben koennen — also sich selbst
    // hochstufen. Wer Rechte vergibt, vergibt sie auch an sich.
    //
    // Wer die Rolle Administrator vergibt oder einem Administrator etwas
    // wegnimmt, muss zusaetzlich selbst Administrator sein. Sonst koennte sich
    // eine Geschaeftsfuehrung zum Superuser machen oder den letzten
    // Administrator entfernen — die Hierarchie waere wirkungslos.
    function touchesAdmin() {
      return request.resource.data.role == 'Administrator'
        || (resource != null && resource.data.role == 'Administrator');
    }

    match /users/{userId} {
      allow read: if ownsExisting();
      allow create: if isTopLevel() && ownsIncoming() && validRole()
        && (request.resource.data.role != 'Administrator' || isAdmin());
      allow update: if isTopLevel() && ownsExisting() && ownsIncoming()
        && companyUnchanged() && validRole()
        && (!touchesAdmin() || isAdmin());
      allow delete: if isTopLevel() && ownsExisting()
        && (resource.data.role != 'Administrator' || isAdmin());
    }

    // --- userPrefs: streng das EIGENE Dokument ---
    //
    // Hier liegen Benachrichtigungs-Einstellungen und die Push-Tokens der
    // Geräte. Ein fremder Token wäre ein Kanal auf ein fremdes Telefon,
    // deshalb keine Firmen-Freigabe wie sonst: nur wer das Dokument ist,
    // darf es lesen und schreiben. Die Cloud Function liest mit
    // Admin-Rechten und ist von diesen Regeln ohnehin nicht betroffen.
    match /userPrefs/{uid} {
      allow read: if signedIn() && uid == request.auth.uid;
      allow create: if signedIn() && uid == request.auth.uid && ownsIncoming()
        && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn() && uid == request.auth.uid && ownsExisting()
        && ownsIncoming() && companyUnchanged();
      allow delete: if false;
    }

    // --- projects: lesen in der Firma; verwalten nur GF/Admin ---
    match /projects/{id} {
      allow read: if ownsExisting();
      allow create: if isLeadership() && ownsIncoming();
      allow update: if isLeadership() && ownsExisting() && ownsIncoming() && companyUnchanged();
      allow delete: if isLeadership() && ownsExisting();
    }

    // --- assignments: lesen in der Firma; planen nur die Leitung ---
    //
    // AENDERN GEHOERTE FRUEHER JEDEM. Die Begruendung dafuer war, dass ein
    // Mitarbeiter `pickedUpMaterials` bestaetigen koenne — dieses Feld kommt
    // in der App aber an keiner Stelle vor, weder lesend noch schreibend. Die
    // Regel stand also fuer eine Funktion offen, die es nicht gibt, waehrend
    // sie tatsaechlich JEDES Feld freigab: `userId`, `date`, `projectNumber`.
    // Ein Monteur konnte sich auf eine andere Baustelle setzen oder den
    // Einsatz eines Kollegen verschieben.
    //
    // Kommt die Bestaetigung spaeter, gehoert sie als eigene Regel hierher —
    // begrenzt auf das eine Feld und den eigenen Einsatz, nicht als Freigabe
    // des ganzen Dokuments.
    match /assignments/{id} {
      allow read: if ownsExisting();
      allow create: if isLeadership() && ownsIncoming();
      allow update: if isLeadership() && ownsExisting() && ownsIncoming() && companyUnchanged();
      allow delete: if isLeadership() && ownsExisting();
    }

    /**
     * einsatzMaterial: die Ruestliste zu einem Tag und einer Baustelle.
     *
     * ZWEI SCHREIBER MIT ZWEI VERSCHIEDENEN RECHTEN, und genau deshalb steht
     * das hier so ausfuehrlich.
     *
     * Die LEITUNG plant die Liste — dieselbe Rolle wie bei `assignments`,
     * damit es auf die Frage „wer plant" eine einzige Antwort gibt.
     *
     * Der MONTEUR hakt ab, was er eingeladen hat, und sonst nichts. Er darf
     * die Liste nicht aendern: was mitzunehmen ist, entscheidet die Planung.
     * Braucht er zusaetzlich etwas, gibt es dafuer die Materialanforderung.
     *
     * WARUM `uids` UND NICHT EIN NACHSCHLAG AUF `assignments`. Die Frage
     * lautet „ist dieser Monteur an diesem Tag auf dieser Baustelle
     * eingeteilt". Beantworten koennte sie nur ein `get()` — aber die
     * Kennungen der Einsaetze sind zufaellig, es gibt also keinen Pfad, den
     * eine Regel bilden koennte. Deshalb traegt das Dokument die Kennungen
     * der Eingeteilten mit; geschrieben werden sie von der Planung, und die
     * Einteilung zieht sie nach, wenn sich die Mannschaft aendert.
     *
     * WARUM `geladen` EIN EIGENES FELD IST. Nur so laesst sich die Grenze
     * ueberhaupt ziehen. Laege der Haken in `positionen`, koennte keine
     * Regel „Haken gesetzt" von „ganze Liste ueberschrieben" unterscheiden —
     * der Monteur haette damit faktisch Schreibrecht auf die Planung.
     */
    match /einsatzMaterial/{id} {
      allow read: if ownsExisting();
      allow create: if isLeadership() && ownsIncoming();
      allow delete: if isLeadership() && ownsExisting();
      allow update: if ownsExisting() && (
        (isLeadership() && ownsIncoming() && companyUnchanged())
        || (request.auth.uid in resource.data.uids
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['geladen', 'updatedAt']))
      );
    }

    // --- materials (Katalog): lesen in der Firma; pflegen GF/Verwaltung/Admin ---
    //
    // Der Kommentar nahm frueher den Lagerstand aus („darf jeder per
    // Transaktion aendern"), die Regel tat das aber nicht: sie gab das ganze
    // Dokument frei, also auch Name, Artikelnummer und Kategorie. Der Stand
    // wird ohnehin nur unter „Material -> Lager" gebucht (`adjustStock`), und
    // dorthin kommt nur Verwaltung oder Leitung. Die Regel deckt sich jetzt
    // mit dem, was die Oberflaeche anbietet.
    match /materials/{id} {
      allow read: if ownsExisting();
      allow create: if (hasRole(['Verwaltung']) || isLeadership()) && ownsIncoming();
      // Die Grenze laeuft zwischen den FELDERN, nicht zwischen den Rollen.
      //
      // Der Monteur bewegt den Bestand in seinem Alltag an zwei Stellen:
      // „Abgeholt" zieht ab, eine Retoure in Originalverpackung schreibt
      // gut. Beides schreibt aus der App heraus unter SEINER Anmeldung, in
      // derselben Transaktion wie die Anforderung. War das gesperrt,
      // scheiterte die ganze Transaktion und der Knopf tat nichts.
      //
      // hasOnly, nicht hasAny: sonst reichte ein mitgeschicktes `stock`, um
      // Preis und Bezeichnung gleich mit zu aendern.
      allow update: if ownsExisting() && ownsIncoming() && companyUnchanged()
        && (hasRole(['Verwaltung']) || isLeadership()
            || (signedIn()
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock'])));
      allow delete: if (hasRole(['Verwaltung']) || isLeadership()) && ownsExisting();
    }

    // --- materialOrders: eigene anlegen/verfolgen; verwalten nur Verwaltung/Leitung ---
    match /materialOrders/{id} {
      // Eigene Bestellungen sehen alle; die Bestellungen des ganzen Betriebs
      // nur, wer sie bearbeitet oder abrechnet.
      allow read: if ownsExisting()
        && (resource.data.userId == request.auth.uid
            || (hasRole(['Verwaltung', 'Buchhaltung']) || isLeadership()));
      allow create: if ownsIncoming()
        && request.resource.data.userId == request.auth.uid
        && !legtVerrechnetAn();
      // Der Besteller darf seine eigene Abholung bestätigen, sonst greift
      // die Verwaltung. Vorher konnte jeder jede Bestellung ändern —
      // inklusive des Verrechnet-Kennzeichens.
      //
      // „Inklusive" stimmte nur zur Haelfte: FREMDE Bestellungen waren danach
      // dicht, die EIGENE nicht. Der Besteller durfte an seiner Position
      // weiterhin jedes Feld setzen, auch `isBilled` — und damit sein
      // Material aus der Rechnung nehmen.
      allow update: if ownsExisting() && ownsIncoming() && companyUnchanged()
        && ((hasRole(['Verwaltung', 'Buchhaltung']) || isLeadership())
            || (resource.data.userId == request.auth.uid
                && !aendertVerrechnung()));
      // Verwaltung pflegt das Material-Dashboard und darf dort löschen
      // (Legacy:4980-4988) — vorher war das versehentlich nur der Leitung erlaubt.
      allow delete: if (hasRole(['Verwaltung']) || isLeadership())
        && ownsExisting();
    }

    // --- timeEntries: eigene anlegen; fremde nur Buchhaltung/GF/Admin ---
    match /timeEntries/{id} {
      // Lesen NUR die eigenen Einträge — plus Buchhaltung/GF/Admin.
      // Zeiteinträge enthalten Krankenstände und Urlaub, also
      // Gesundheitsdaten im Sinne von Art. 9 DSGVO. Ohne diese Grenze
      // könnte jeder Monteur die Abwesenheiten aller Kollegen auslesen,
      // auch direkt an der Oberfläche vorbei.
      allow read: if ownsExisting()
        && (resource.data.userId == request.auth.uid
            || isBuchOrTop());
      // Das Verrechnet-Kennzeichen gehoert der Buchhaltung, nicht dem
      // Eigentuemer des Eintrags. Sonst nimmt sich ein Monteur seine eigenen
      // Stunden aus der Rechnung — und der Kunde zahlt sie nie.
      allow create: if ownsIncoming()
        && (isBuchOrTop()
            || (request.resource.data.userId == request.auth.uid
                && !legtVerrechnetAn()));
      allow update: if ownsExisting() && ownsIncoming() && companyUnchanged()
        && (isBuchOrTop()
            || (resource.data.userId == request.auth.uid
                && !aendertVerrechnung()));
      allow delete: if ownsExisting()
        && (resource.data.userId == request.auth.uid
            || isBuchOrTop());
    }

    // --- workSheets: Handwerksscheine ---
    //
    // DIE UNVERAENDERBARKEIT STEHT HIER, nicht in der Oberflaeche. Ein Beleg,
    // den der Kunde unterschrieben hat und den man danach im System aendern
    // kann, ist wertlos: der Kunde hat etwas anderes unterschrieben, als im
    // System steht, und niemand koennte den Unterschied nachweisen.
    //
    // Deshalb:
    //   Entwurf         -> aenderbar
    //   Unterschrieben  -> NUR NOCH der Uebergang nach „Storniert"
    //   Storniert       -> gar nichts mehr
    //
    // Geloescht wird nie. Ein spurlos verschwundener Beleg waere schlimmer
    // als ein falscher — der Storno bleibt sichtbar und traegt seinen Grund.
    match /workSheets/{id} {
      function istEntwurf() {
        return resource.data.status == 'Entwurf';
      }
      function nurStorno() {
        // Vom unterschriebenen Schein fuehrt genau ein Weg weg, und der
        // aendert den Inhalt nicht.
        return resource.data.status == 'Unterschrieben'
          && request.resource.data.status == 'Storniert'
          && request.resource.data.zeiten == resource.data.zeiten
          && request.resource.data.material == resource.data.material
          && request.resource.data.notizen == resource.data.notizen
          && request.resource.data.unterschriften == resource.data.unterschriften;
      }

      allow read: if ownsExisting();
      allow create: if ownsIncoming()
        && request.resource.data.status == 'Entwurf'
        && request.resource.data.erstelltVonUid == request.auth.uid;
      allow update: if ownsExisting() && ownsIncoming() && companyUnchanged()
        && (istEntwurf() || (nurStorno() && isLeadership()));
      allow delete: if false;
    }

    // --- quotes: Angebote ---
    //
    // Kalkulieren ist Leitungssache: hier stehen Preise, Margen und
    // Stundenannahmen. Die Buchhaltung darf mitlesen — ein angenommenes
    // Angebot ist die Vorstufe der Rechnung.
    //
    // Geloescht wird nur der Entwurf. Ein versendetes oder abgelehntes
    // Angebot bleibt nachvollziehbar: was dem Kunden genannt wurde, gehoert
    // nicht spurlos entfernt.
    match /quotes/{id} {
      allow read: if ownsExisting() && (isLeadership() || isBuchOrTop());
      allow create: if isLeadership() && ownsIncoming();
      allow update: if isLeadership() && ownsExisting() && ownsIncoming()
        && companyUnchanged();
      allow delete: if isLeadership() && ownsExisting()
        && resource.data.status == 'Entwurf';
    }

    // --- customers: Kundenstammdaten ---
    //
    // Lesen darf das ganze Büro: die Buchhaltung braucht die Rechnungsadresse,
    // die Verwaltung den Ansprechpartner. Auch der Monteur — er sieht auf
    // seiner Baustelle ohnehin Namen und Telefonnummer und würde sonst nur
    // eine leere Zeile vorfinden.
    //
    // Ändern darf nur die Leitung. Eine geänderte Rechnungsadresse landet auf
    // der nächsten Rechnung; das ist keine Nebensächlichkeit.
    match /customers/{id} {
      allow read: if ownsExisting();
      allow create: if isLeadership() && ownsIncoming();
      allow update: if isLeadership() && ownsExisting() && ownsIncoming()
        && companyUnchanged();
      allow delete: if isLeadership() && ownsExisting();
    }

    // --- vacations: Urlaubsanträge ---
    //
    // DIE ENTSCHEIDENDE GRENZE IST, WER GENEHMIGT. Stünde sie nur in der
    // Oberfläche, könnte sich jeder Monteur seinen Urlaub per Konsole selbst
    // genehmigen — und weil eine Genehmigung die Urlaubstage ins Zeitkonto
    // schreibt, wäre das zugleich ein Weg, sich bezahlte Tage zu verschaffen.
    //
    // Deshalb:
    //   anlegen        -> nur für SICH SELBST und nur als „Beantragt"
    //   ändern (selbst) -> nur solange „Beantragt", und der Status bleibt es
    //   entscheiden    -> nur Buchhaltung, Geschäftsführung, Administrator
    //   löschen        -> nur der Antragsteller, und nur vor der Entscheidung
    //
    // GELESEN wird weiter, als es die Aufgabe verlangt: die eigenen Anträge
    // immer, alle Anträge zusätzlich von der Leitung — auch von der
    // Projektleitung, die zwar nicht entscheidet, aber einteilt. Wer den
    // Urlaub eines Monteurs beim Planen nicht sieht, plant ihn ein. Ein
    // Urlaubsantrag ist im Unterschied zum Krankenstand kein Gesundheitsdatum;
    // die Grenze bei den Zeiteinträgen bleibt davon unberührt.
    match /vacations/{id} {
      function eigener() {
        return resource.data.userId == request.auth.uid;
      }
      function eigenerNeu() {
        return request.resource.data.userId == request.auth.uid;
      }
      function nochOffen() {
        return resource.data.status == 'Beantragt';
      }

      allow read: if ownsExisting() && (eigener() || isLeadership() || isBuchOrTop());

      allow create: if ownsIncoming()
        && eigenerNeu()
        && request.resource.data.status == 'Beantragt'
        // Ein Antrag, der sich schon als entschieden ausgibt, ist keiner.
        && !('entschiedenVonUid' in request.resource.data);

      allow update: if ownsExisting() && ownsIncoming() && companyUnchanged()
        && (
          darfUrlaubEntscheiden()
          // Der Antragsteller darf seinen offenen Antrag noch ändern — aber
          // nicht seinen Status. Sonst wäre „ändern" die Hintertür zu
          // „genehmigen".
          || (eigener() && nochOffen()
              && request.resource.data.status == 'Beantragt'
              && request.resource.data.userId == resource.data.userId)
        );

      // Entschiedene Anträge bleiben stehen: sie sind der Nachweis, dass
      // entschieden wurde. Zurückgenommen wird über den Status „Storniert".
      allow delete: if ownsExisting() && eigener() && nochOffen();
    }

    // --- monthlyStats / monthlyStatsMeta: verdichtete Zeitkonten ---
    //
    // NUR LESEN, und zwar unter derselben Grenze wie die Zeiteinträge selbst:
    // die Bilanzen enthalten gezählte Krank- und Urlaubstage und damit
    // Gesundheitsdaten im Sinne von Art. 9 DSGVO. Wer die Rohdaten nicht
    // sehen darf, darf auch ihre Summe nicht sehen — sonst wäre die Grenze
    // bei den Zeiteinträgen umgangen, indem man einen Schritt weiter rechts
    // nachschaut.
    //
    // GESCHRIEBEN WIRD AUSSCHLIESSLICH SERVERSEITIG. Der Trigger läuft mit
    // Admin-Rechten und ist an die Rules nicht gebunden; jedes Schreibrecht
    // hier wäre eine Möglichkeit, den eigenen Stundensaldo zu setzen, ohne
    // eine einzige Buchung anzufassen.
    match /monthlyStats/{id} {
      allow read: if ownsExisting()
        && (resource.data.userId == request.auth.uid || isBuchOrTop());
      allow write: if false;
    }

    match /monthlyStatsMeta/{id} {
      allow read: if ownsExisting()
        && (resource.data.userId == request.auth.uid || isBuchOrTop());
      allow write: if false;
    }

    // --- followUps (KI-Magic-Moment): lesen/schreiben in der Firma ---
    match /followUps/{id} {
      allow read: if ownsExisting();
      allow create: if ownsIncoming();
      allow update: if ownsExisting() && ownsIncoming() && companyUnchanged();
      allow delete: if ownsExisting();
    }

    // --- invoices: nur GF/Buchhaltung/Admin ---
    match /invoices/{id} {
      allow read: if ownsExisting()
        && hasRole(['Buchhaltung', 'Geschäftsführung', 'Administrator']);
      allow create: if hasRole(['Buchhaltung', 'Geschäftsführung', 'Administrator']) && ownsIncoming();
      allow update: if hasRole(['Buchhaltung', 'Geschäftsführung', 'Administrator'])
        && ownsExisting() && ownsIncoming() && companyUnchanged();
      // NUR DER STORNO IST LOESCHBAR. Vorher liess sich jede Rechnung
      // entfernen — auch eine offene oder bezahlte. Das passte weder zur
      // Oberflaeche (sie bietet „Loeschen" ausschliesslich beim Storno an)
      // noch zum Umgang mit den uebrigen Belegen: ein unterschriebener
      // Handwerksschein laesst sich gar nicht loeschen, und der Zaehler auch
      // nicht. Ausgerechnet beim Beleg fuer das Finanzamt war die Grenze die
      // weichste.
      allow delete: if hasRole(['Buchhaltung', 'Geschäftsführung', 'Administrator'])
        && ownsExisting()
        && resource.data.paymentStatus == 'Storniert';
    }

    // --- counters: fortlaufende Nummernkreise, einer je Firma ---
    //
    // Hier liegt der Rechnungszähler. Er darf nur steigen: eine Nummer, die
    // einmal vergeben wurde, darf nie ein zweites Mal herauskommen, sonst
    // trägt der Betrieb zwei Rechnungen mit derselben Nummer in den Büchern.
    // Löschen ist deshalb ausgeschlossen — ein neu angelegter Zähler begänne
    // wieder von vorne.
    match /counters/{id} {
      // Der Mandant steckt in der Dokument-ID, nicht (nur) im Feld. Das ist
      // hier entscheidend: beim allerersten Zugriff existiert der Zähler noch
      // nicht, `resource` ist null, und eine Prüfung auf
      // resource.data.companyId würde die Regel scheitern lassen — der erste
      // Rechnungslauf eines Betriebs wäre dauerhaft gesperrt.
      // Zwei getrennte Nummernkreise, zwei Zaehler: Rechnungen und Angebote.
      // Ein gemeinsamer Zaehler wuerde beide loechrig machen.
      function ownCounter() {
        return signedIn()
          && (id == tokenCompany() + '_invoices' || id == tokenCompany() + '_quotes');
      }
      function billing() {
        return hasRole(['Buchhaltung', 'Geschäftsführung', 'Administrator']);
      }
      // Angebote kalkuliert die Leitung — auch die Projektleitung, die sonst
      // keine Rechnungen schreibt.
      function darfZaehlen() {
        return id == tokenCompany() + '_quotes' ? isLeadership() : billing();
      }

      allow read: if ownCounter() && darfZaehlen();
      allow create: if ownCounter() && darfZaehlen() && ownsIncoming()
        && request.resource.data.lastSeq is int
        && request.resource.data.lastSeq > 0;
      /**
       * Beginnt hier ein neues Jahr?
       *
       * `get` mit Vorgabe, weil aeltere Zaehlerdokumente das Feld `year` noch
       * nicht tragen — ein direkter Zugriff liesse die Regel dort scheitern.
       */
      function neuesJahr() {
        return request.resource.data.get('year', 0) != resource.data.get('year', 0);
      }

      allow update: if ownCounter() && darfZaehlen() && ownsIncoming() && companyUnchanged()
        && request.resource.data.lastSeq is int
        /**
         * Der Angebotszaehler beginnt zum Jahreswechsel neu bei 1; der
         * Rechnungskreis laeuft dagegen monoton weiter.
         *
         * Vorher stand hier fuer Angebote nur `lastSeq > 0`. Das erlaubte
         * jeden Wert — auch einen kleineren, auch mitten im Jahr. Damit war
         * „Nummernkreise nur steigend" fuer Angebote gar nicht durchgesetzt,
         * und zwei Kunden konnten dieselbe Angebotsnummer bekommen. Der Neu-
         * beginn ist jetzt an den Jahreswechsel gebunden und auf genau 1
         * festgelegt; innerhalb eines Jahres steigt der Zaehler wie der
         * Rechnungskreis.
         */
        && (id == tokenCompany() + '_quotes' && neuesJahr()
            ? request.resource.data.lastSeq == 1
            : request.resource.data.lastSeq > resource.data.lastSeq);
      allow delete: if false;
    }

    // Standard: alles andere verboten.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
