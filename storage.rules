rules_version = '2';

/**
 * Firebase Storage — die Fotos an den Handwerksscheinen.
 *
 * DAS IST DIE ERSTE STELLE, an der diese App überhaupt Dateien vom Gerät
 * annimmt. Bis hierher kam alles ohne Storage aus: die Unterschriftsbilder
 * passen als PNG von rund zehn Kilobyte direkt ins Firestore-Dokument. Ein
 * Handyfoto tut das nicht — es ist drei- bis fünfmal so gross wie das, was
 * ein Dokument fasst.
 *
 * DIE GRENZEN HIER SIND NICHT DIESELBEN WIE IN FIRESTORE, und das hat einen
 * Grund: eine Storage-Regel sieht die Datei, nicht ihren Inhalt. Sie kann
 * nicht prüfen, ob das Bild zum Schein passt — nur, WER es ablegt, WO, WIE
 * GROSS und von WELCHEM TYP. Was sie nicht kann, tut das Firestore-Dokument:
 * der Schein führt die Liste seiner Fotos samt Inhalts-Hash, und die ist nach
 * der Unterschrift eingefroren.
 *
 * Die beiden zusammen tragen: ein ausgetauschtes Bild im Storage passt nicht
 * mehr zum Hash im Schein, und den Hash im Schein ändert nach der
 * Unterschrift niemand mehr.
 */
service firebase.storage {
  match /b/{bucket}/o {

    function angemeldet() {
      return request.auth != null;
    }

    /**
     * Der Mandant aus dem Token, nicht aus dem Pfad.
     *
     * Käme er aus dem Pfad, prüfte die Regel den Pfad gegen sich selbst.
     */
    function tokenFirma() {
      return request.auth.token.companyId;
    }

    function istBild() {
      return request.resource.contentType.matches('image/.*');
    }

    /**
     * Zwei Megabyte. Der Client verkleinert auf 1600 Bildpunkte und JPEG —
     * das landet bei zwei- bis vierhundert Kilobyte. Die Grenze fängt also
     * nicht den Normalfall ab, sondern den Fehler: eine Fassung, die das
     * Verkleinern überspringt, und jeden Versuch, den Bucket als Ablage zu
     * benutzen.
     */
    function passendeGroesse() {
      return request.resource.size < 2 * 1024 * 1024;
    }

    match /scheine/{companyId}/{scheinId}/{datei} {
      /*
        LESEN darf der ganze Betrieb. Der Monteur hat die Bilder gemacht, das
        Büro braucht sie beim Rückfragen des Kunden, die Buchhaltung sieht sie
        an der Rechnung. Eine feinere Grenze wäre hier Aufwand ohne Gewinn:
        wer den Schein sehen darf, darf auch seine Fotos sehen.
      */
      allow read: if angemeldet() && companyId == tokenFirma();

      /*
        SCHREIBEN nur in den eigenen Mandanten, nur Bilder, nur bis 2 MB.

        ÜBERSCHREIBEN IST NICHT AUSGESCHLOSSEN, und das ist Absicht: ein
        abgebrochener Upload muss sich wiederholen lassen, sonst bliebe eine
        halbe Datei liegen und der Monteur käme nicht weiter. Der Schutz gegen
        das nachträgliche Austauschen sitzt woanders — im Inhalts-Hash, den
        der eingefrorene Schein festhält. Eine Regel, die das Überschreiben
        verböte, machte das Wiederholen unmöglich und den Beleg kein bisschen
        sicherer.
      */
      allow write: if angemeldet()
        && companyId == tokenFirma()
        && istBild()
        && passendeGroesse();

      /*
        LÖSCHEN gehört zum Entwurf: ein versehentlich aufgenommenes Bild muss
        weg, bevor unterschrieben wird. Danach schützt es der Schein — sein
        Hash zeigt eine fehlende Datei genauso an wie eine ausgetauschte.
      */
      allow delete: if angemeldet() && companyId == tokenFirma();
    }

    /*
      ALLES ANDERE IST ZU. Die Datenausleitung läuft über einen eigenen
      Bucket und mit Admin-Rechten an diesen Regeln vorbei; ein offener
      Standardpfad wäre eine Ablage, die jeder Angemeldete vollschreiben kann.
    */
    match /{alles=**} {
      allow read, write: if false;
    }
  }
}
