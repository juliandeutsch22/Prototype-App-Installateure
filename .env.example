# Firebase Web-Konfiguration — pro Umgebung/Mandant in .env hinterlegen.
# NIEMALS echte Werte committen. .env steht in .gitignore.
# Werte stammen aus der Firebase Console > Projekteinstellungen > Web-App.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Cloud Functions Region (DSGVO: EU-Region, z. B. Frankfurt)
VITE_FUNCTIONS_REGION=europe-west3

# Optional: Firebase-Emulatoren im Dev-Modus verwenden ("true"/"false")
VITE_USE_EMULATORS=false

# Name im Kopf des Anmeldebildschirms (vor dem Login ist der Mandant unbekannt).
# Beispiel für den Perl-Piloten: "Perl Installationen"
VITE_PORTAL_NAME=
