# ---------------------------------------------------------------------------
# Supabase — die Datenbank, die Anmeldung und der Dateispeicher
# ---------------------------------------------------------------------------
# Werte aus dem Supabase-Dashboard > Project Settings > API.
#
# Der anon- bzw. Publishable-Key ist KEIN Geheimnis — er steht im
# ausgelieferten Bundle. Was die Daten schützt, ist der Zeilenschutz in der
# Datenbank, nicht die Geheimhaltung dieses Schlüssels.
#
# Den service_role- bzw. Secret-Key hier NIEMALS eintragen: er hebelt den
# Zeilenschutz vollständig aus, und im Browser hätte ihn jeder.
#
# OHNE DIESE BEIDEN STARTET DIE APP NICHT — und das ist Absicht. Eine App, die
# sich ohne Zugangsdaten startet und erst beim ersten Speichern scheitert,
# kostet mehr Zeit als eine, die gleich sagt, was fehlt.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Firebase — nur noch der Versandweg für Push-Meldungen
# ---------------------------------------------------------------------------
# Seit dem 19.09.2026 liegen Daten, Anmeldung und Serverlogik bei Supabase.
# Von Firebase bleibt zweierlei: das Hosting und FCM.
#
# WARUM FCM BLEIBT: eine Push-Meldung an ein Telefon braucht einen Dienst, den
# Apple und Google akzeptieren; Supabase hat dafür keinen Ersatz. Ausgelöst
# wird sie von einem Postgres-Trigger, verschickt von der Edge Function
# `push-melden`.
#
# OHNE DIESE WERTE LÄUFT DIE APP VOLLSTÄNDIG — es gibt nur keine Meldungen
# aufs Telefon, und die Einstellungen sagen das auch so.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Aus der Firebase Console > Cloud Messaging > Web-Push-Zertifikate.
VITE_FIREBASE_VAPID_KEY=

# ---------------------------------------------------------------------------
# Anzeige
# ---------------------------------------------------------------------------
# Name im Kopf des Anmeldebildschirms (vor der Anmeldung ist der Betrieb
# unbekannt). Beispiel für den Perl-Piloten: "Perl Installationen"
VITE_PORTAL_NAME=
