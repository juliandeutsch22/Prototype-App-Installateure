# Firebase Web-Konfiguration — pro Umgebung/Mandant in .env hinterlegen.
# NIEMALS echte Werte committen. .env steht in .gitignore.
# Werte stammen aus der Firebase Console > Projekteinstellungen > Web-App.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Cloud Functions Region (DSGVO: EU-Region, z. B. Frankfurt)
VITE_FUNCTIONS_REGION=europe-west3

# Optional: Firebase-Emulatoren im Dev-Modus verwenden ("true"/"false")
VITE_USE_EMULATORS=false

# Name im Kopf des Anmeldebildschirms (vor dem Login ist der Mandant unbekannt).
# Beispiel für den Perl-Piloten: "Perl Installationen"
VITE_PORTAL_NAME=

# --- Supabase ---------------------------------------------------------------
# Werte aus dem Supabase-Dashboard > Project Settings > API.
# Der anon- bzw. Publishable-Key ist KEIN Geheimnis — er steht im
# ausgelieferten Bundle. Was die Daten schützt, ist der Zeilenschutz in der
# Datenbank, nicht die Geheimhaltung dieses Schlüssels.
#
# Den service_role- bzw. Secret-Key hier NIEMALS eintragen: er hebelt den
# Zeilenschutz vollständig aus, und im Browser hätte ihn jeder.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Woher die Datenschicht liest und schreibt. Alles ausser `postgres` heisst
# Firestore — wer die Variable vergisst, bekommt den Stand, der heute läuft,
# und nicht eine leere Datenbank. Umgelegt wird sie in Stufe 8, an dieser
# einen Stelle.
VITE_DATENQUELLE=firestore
