# Cloud-Functions-Secrets — NIEMALS im Frontend, niemals committen.
# In Produktion via Firebase Secrets Manager setzen:
#   firebase functions:secrets:set ANTHROPIC_API_KEY
#   firebase functions:secrets:set TRANSCRIPTION_API_KEY

# Anthropic (KI-Extraktion). DSGVO: AV-Vertrag/DPA mit Anbieter erforderlich.
ANTHROPIC_API_KEY=

# Transkription (Sprache -> Text). Whisper-kompatibler Endpunkt.
# DSGVO: EU-Verarbeitung / DPA bevorzugen (Spec §10).
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_URL=https://api.openai.com/v1/audio/transcriptions
TRANSCRIPTION_MODEL=whisper-1
