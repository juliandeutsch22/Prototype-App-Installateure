# Dependencies
node_modules

# Build output
dist
*.tsbuildinfo
# Von `tsc -b` aus vite.config.ts erzeugte Artefakte
vite.config.js
vite.config.d.ts

# Environment / Secrets — NIE committen
.env
.env.local
.env.*.local
!.env.example
*.serviceaccount.json

# Firebase Hosting
.firebase
firebase-debug.log

# Editor / OS
.DS_Store
.vscode/*
!.vscode/extensions.json
*.log

# Service-Account-Schlüssel (Bootstrap/Produktion) — NIE committen
serviceAccount*.json
*serviceaccount*.json

# ProjectAtlas: lokaler Index (SQLite, 32 MB) — gehoert nicht ins Repo.
# Neu erzeugt mit `projectatlas init`. Die MCP-Konfiguration bleibt dagegen
# versioniert, damit jeder Agent denselben Einstieg findet.
.projectatlas/*.db
.projectatlas/*.db-shm
.projectatlas/*.db-wal
.projectatlas/*.lock
.projectatlas/*.toon
# Die je Host erzeugten Kopien der MCP-Konfiguration tragen absolute Pfade
# DIESER Maschine. Versioniert ist nur `.mcp.json`.
.projectatlas/projectatlas.claude.mcp.json
.projectatlas/projectatlas.mcp.json
.projectatlas/projectatlas.opencode.json
# Aus shared/ erzeugte Kopien — siehe scripts/edge-shared-uebernehmen.mjs
supabase/functions/_shared/

# Durchklick (Playwright): Bilder, Spuren und Berichte eines Laufs. Sie sind
# Diagnose, kein Quelltext — und ein Trace-Archiv wiegt Megabyte.
test-results/
playwright-report/
