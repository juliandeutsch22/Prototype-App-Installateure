# Nur auf dem Hosting-System hinterlegen, niemals in Chat oder Git einfügen.
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
CONTACT_ORIGINS=https://senklot.at,https://www.senklot.at
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
RESEND_API_KEY=
# Muss als Absender beim Versanddienst verifiziert sein.
RESEND_FROM=Senklot <office@senklot.at>
# Nur hinter einem vertrauenswürdigen Proxy, der X-Forwarded-For setzt/anhängt.
TRUST_PROXY=false
